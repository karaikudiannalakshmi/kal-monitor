// storage.rules
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Voice notes: staff can upload to their own folder, admin reads all
    match /voice/{staffId}/{date}/{taskId} {
      allow read:  if request.auth != null &&
                   (request.auth.uid == staffId || isAdmin());
      allow write: if request.auth != null &&
                   request.auth.uid == staffId;
    }

    function isAdmin() {
      return firestore.exists(
        /databases/(default)/documents/admins/$(request.auth.uid)
      );
    }
  }
}
