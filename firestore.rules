// firestore.rules
// Deploy with: firebase deploy --only firestore:rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin users collection — only admin can write
    match /admins/{uid} {
      allow read: if request.auth != null;
      allow write: if false; // manage via Firebase console
    }

    // Staff profiles — admin can write, staff can read own
    match /staff/{staffId} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }

    // Daily tasks — admin uploads, staff reads own tasks
    match /tasks/{taskId} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }

    // Compliance logs — staff writes own logs, admin reads all
    match /logs/{logId} {
      allow read:  if isAdmin() || isOwner(resource.data.staffId);
      allow create: if request.auth != null
                    && request.resource.data.staffId == request.auth.uid;
      allow update: if isAdmin() || isOwner(resource.data.staffId);
    }

    // Voice notes metadata (URL stored here, blob in Storage)
    match /voiceNotes/{noteId} {
      allow read:  if isAdmin() || isOwner(resource.data.staffId);
      allow write: if request.auth != null
                   && request.resource.data.staffId == request.auth.uid;
    }

    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
  }
}
